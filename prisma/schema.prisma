// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Таблицы Better Auth. Старая модель User выше (форма /register) остаётся отдельно.
model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  plan          Plan          @default(FREE)
  planUntil     DateTime?
  sessions      AuthSession[]
  accounts      AuthAccount[]
  drafts        Draft[]
  rewriteUsage  RewriteUsage[]
  consents      Consent[]

  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

enum Plan {
  FREE
  PRO
}

// Черновик переписанного поста
model Draft {
  id        String       @id
  userId    String
  user      AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  media     DraftMedia[]

  @@index([userId, createdAt])
  @@map("draft")
}

// Файл черновика. Сам файл лежит в S3 под ключом key
model DraftMedia {
  id          String   @id @default(cuid())
  draftId     String
  draft       Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  key         String   @unique
  contentType String
  size        Int
  kind        String
  position    Int
  createdAt   DateTime @default(now())

  @@index([draftId])
  @@map("draft_media")
}

// Одно успешное переписывание, нужно для месячного лимита
model RewriteUsage {
  id        String   @id @default(cuid())
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("rewrite_usage")
}

// Факт принятия документа: кто, когда, с какого IP и какую версию
model Consent {
  id         String   @id @default(cuid())
  userId     String
  user       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  ip         String?
  userAgent  String?
  acceptedAt DateTime @default(now())

  @@index([userId])
  @@map("consent")
}
