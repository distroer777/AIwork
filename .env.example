# Скопируйте в .env и заполните. Настоящие значения в git не попадают.

# База данных в Docker
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_PORT=
DATABASE_URL=

# Авторизация (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Почта RuSender (если пусто, код подтверждения печатается в терминал)
RUSENDER_API_KEY=
RUSENDER_API_URL=
RUSENDER_FROM_EMAIL=
RUSENDER_FROM_NAME=

# OpenAI через прокси
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROXY_URL=
OPENAI_BASE_URL=

# Файловое хранилище S3 (локально MinIO, в проде VK Cloud)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PORT=
S3_CONSOLE_PORT=
S3_FORCE_PATH_STYLE=
S3_AUTO_CREATE_BUCKET=
