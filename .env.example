# Скопируйте в .env и заполните. Настоящие значения в git не попадают.

# База данных в Docker
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_PORT=
DATABASE_URL=

# Авторизация (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Почта RuSender (если пусто, код подтверждения печатается в терминал)
RUSENDER_API_KEY=
RUSENDER_API_URL=
RUSENDER_FROM_EMAIL=
RUSENDER_FROM_NAME=

# OpenAI через прокси
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROXY_URL=
OPENAI_BASE_URL=
